// Point s32768-d10: slots 32768, depth 10, security 128, precision 15.
//
// DESILO is sized by its ladder and its slots and picks the ring itself, so
// this is the point restated in the library's own terms and nothing more.
// The ring it chooses is printed by init, because the config cannot say it.
{
  "scheme": "ckks",

  // The host across every core the runner reports, as the OpenFHE rows take
  // the machine. 0 is the machine; the library's own default is four, which
  // would measure the default rather than the library.
  "mode": "parallel",
  "thread_count": 0,
  "device_id": 0,

  // Fresh ciphertexts at the top of the ladder.
  "encrypt_level": null,

  // One multiplication needs one key.
  "keys": ["relinearization"],

  // Sized by the ring, not by the ladder, and the reason is the library's:
  // asked for 32768 slots at max_level 10 it answers "The given slot count is
  // too large" — it picks the ring from the ladder, and ten levels do not
  // reach a ring that holds 32768 slots. So the ring is named here and the
  // ladder is what the library fits into it, which is what this point wants
  // in any case: the width is the question and the ring is the answer.
  "log_coeff_count": 16,
  "log_slot_count": 15,
  "special_prime_count": 2,

  "max_level": null,
  "slot_count": null,
  "use_bootstrap": false,
  "fixed_rotation_deltas": [],
  "shape": null
}
